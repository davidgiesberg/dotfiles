#!/opt/homebrew/bin/bash
DATE_STR=$(date +%Y-%m-%d)
TIME_STR=$(date +%H:%M)
NOTATIONAL_DATA_DIR="$HOME/Dropbox/new_notes/current"
NOTE_FILE="$NOTATIONAL_DATA_DIR/$DATE_STR.md"

if [[ -z "$@" ]]; then
    read NOTE
else
    NOTE="$@"
fi

if [[ -z "$NOTE" ]]; then
    exit 0
fi

NOTE_TEXT="- [x] $TIME_STR: ${NOTE^}"

if [ "$(tail -c1 "$NOTE_FILE"; echo x)" != $'\nx' ]; then
    echo "" >>"$NOTE_FILE"
fi

echo "$NOTE_TEXT" >> "$NOTE_FILE"
echo "$NOTE_TEXT"
