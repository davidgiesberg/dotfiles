# bootstrap with brew install git

[user]
	name = David Giesberg
	email = git@davidgiesberg.net
[alias]
	co = checkout
	wdiff = diff --color-words
[color]
	diff = auto
	status = auto
	branch = auto
[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
[apply]
	whitespace = nowarn
[push]
	default = simple
	autoSetupRemote = true
[init]
	templatedir = ~/.git-templates
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true

# https://developer.1password.com/docs/ssh/git-commit-signing/
[user]
        signingkey = <REPLACEME>

[gpg]
        format = ssh

[gpg "ssh"]
        program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
        gpgsign = true
